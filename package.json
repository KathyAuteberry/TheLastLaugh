{
  "name": "the-last-laugh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "node scripts/validate.mjs",
    "extract:ikuya": "python3 -I scripts/extract_ikuya.py",
    "e2e": "playwright test",
    "deploy": "npm run build && npm test && wrangler pages deploy dist --project-name the-last-laugh --branch master",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name the-last-laugh --branch preview"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "ajv": "8.17.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "wrangler": "4.151.2"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
